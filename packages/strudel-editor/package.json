{
  "name": "@webgamekit/strudel-editor",
  "version": "0.2.0",
  "description": "The Strudel live-coding editor as a Vue 3 component: code editor, node editor, timeline, transcription and WAV or MIDI export.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cnotv/strudel-node-editor.git",
    "directory": "packages/strudel-editor"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helpers": {
      "types": "./dist/helpers.d.ts",
      "import": "./dist/helpers.js"
    },
    "./style.css": "./dist/style.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && pnpm run build:types && cp src/styles/tokens.css dist/tokens.css",
    "prepublishOnly": "pnpm run build",
    "build:types": "vue-tsc -p tsconfig.build.json || test -f dist/index.d.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@strudel/codemirror": "1.3.0",
    "@strudel/core": "1.2.6",
    "@strudel/draw": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/soundfonts": "1.3.0",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/webaudio": "1.3.0",
    "@tonaljs/tonal": "4.10.0",
    "@tonejs/midi": "^2.0.28",
    "@webgamekit/strudel-flow": "workspace:^",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.563.0",
    "radix-vue": "^1.9.17"
  },
  "peerDependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "sharp": "^0.34.5",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vue-tsc": "^2.0.0",
    "@strudel/midi": "1.3.0"
  }
}
